screenshot: 'data:image/png;base64,'
configuration:
  projectTitle: Title Screen Demo 01
  projectVersion: 1.0.0
  projectWebsite: 'https://abstractpolygon.com/'
  projectDeveloper: AbstractPolygon
  projectDescription: |-
    This is a demonstration of using the Title Screen Kernel.

    Use the "End Title Screen" block to switch back to gameplay kernel.
  showScore: true
  enableScoreFade: false
  showBlankLines: true
  enablePlayer0SpriteColors: false
  enablePlayer1SpriteColors: false
  enablePfColors: false
  enableSuperchip: false
  enableOptimizationSpeed: false
  enableInlineRand: true
  enableRand16: true
  enableCycleScore: false
  enableScanlinesDebug: false
  pfres: 24
  enablePfRowHeight: false
  pfrowheight: 8
  tvStandard: ntsc
  romSize: 8k
  scoreFont: ''
  secondaryScoreFont: ''
  muteAllAudio: false
  showVariableComments: true
