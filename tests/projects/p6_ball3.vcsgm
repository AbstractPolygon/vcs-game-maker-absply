  enablePfRowHeight: false
  pfrowheight: 3
  tvStandard: ntsc
  romSize: 64k
  scoreFont: .21stcentury
  muteAllAudio: true
  showVariableComments: false
  projectTitle: Bricks of Olympus
  projectDeveloper: AbstractPolygon
  projectDescription: |-
    A Greek-themed take on a classic brick breaker.

    Shows off some features of VCS Game Maker:
    - Title Screen Kernel
    - Text Minikernel+ (improved/expanded Text Minikernel)
    - Player Input
    - Projectile/bounce blocks
    - Playfield offset
    - Playfield clear radius
    - Sprite Collision (paddle, powerups)
    - Playfield & Background colors
  projectWebsite: 'https://abstractpolygon.com/'
  scoreFontExtraGlyphsEnabled: true
  projectVersion: 0.0.24
  secondaryScoreFont: ''
  kernel: dpcplus
  dpcPlusRowScanlines: 16
  dpcPlusPfres: 24
  enableDpcPlusPfColors: false
  enableDpcPlusBkColors: false
  enableDpcPlusAudio: false
  enableFastMath: true
  enableSuperchipStandard: true
  dpcPlusSpriteMax: 5
  scoreDigits: 6
  textMaxDisplayWidth: 12
  scorePaddingLines: 0
  textBkColor: 0
  enableAtariVox: false
  avoxFileStart: 65
  avoxFileEnd: 65
  enableFireCoprocessor: true
  textScrollCursorBlinkSpeed: 8
  enableHarmonyCartFix: true
  dpcPlusScoreLineColorsOff: true
